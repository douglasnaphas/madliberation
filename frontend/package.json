    "browserslist": "^4.22.1",
    "next": "^14.1.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^5.2.0",
    "typescript": "^5.3.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
